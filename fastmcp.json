{
  "name": "DPYC Oracle",
  "source": {
    "path": "src/dpyc_oracle/server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "type": "uv",
    "project": "."
  },
  "deployment": {
    "env": {
      "DPYC_COMMUNITY_BASE_URL": "https://raw.githubusercontent.com/lonniev/dpyc-community/main",
      "DPYC_COMMUNITY_REPO": "lonniev/dpyc-community",
      "CACHE_TTL_SECONDS": "300",
      "GITHUB_TOKEN": "${GITHUB_TOKEN}"
    }
  }
}
